{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 0 * * *" },
    { "path": "/api/cron/monday", "schedule": "30 1 * * 1" },
    { "path": "/api/cron/friday", "schedule": "30 8 * * 5" },
    { "path": "/api/cron/monthly", "schedule": "0 1 1 * *" }
  ]
}
