# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable (anon) key>   # safe for the browser; RLS protects the data
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>              # SERVER ONLY: admin invites, cron jobs, seeding. Never expose.

# --- App ---
NEXT_PUBLIC_APP_URL=https://<your-vercel-url>             # auth redirects + OpenRouter HTTP-Referer
ADMIN_EMAIL=<the single admin email>                      # copied to app_settings.admin_email by the seed script
ALLOWED_EMAIL_DOMAIN=                                     # optional second sign-up gate, e.g. acsiatech.com
APP_TIMEZONE=Asia/Kolkata

# --- OpenRouter (AI operator) ---
OPENROUTER_API_KEY=<openrouter-key>                       # SERVER ONLY. Without it the AI features fall back to plain forms.
AI_MONTHLY_BUDGET_USD=150                                 # leader is alerted at 80%

# --- Cron protection (Vercel Cron sends this as Authorization: Bearer) ---
CRON_SECRET=<long-random-string>

# --- Email: custom SMTP is configured in the Supabase dashboard (Auth > SMTP), not here ---
